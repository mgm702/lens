<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{.Label}} — Lens</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f8f9fa; color: #212529; }
    header { background: #1a1a2e; color: white; padding: 1.5rem 2rem; }
    header h1 { margin: 0; font-size: 1.2rem; }
    header p { margin: 0.25rem 0 0; opacity: 0.7; font-size: 0.85rem; }
    main { max-width: 900px; margin: 2rem auto; padding: 0 1.5rem; }
    .meta { display: flex; gap: 2rem; background: white; border-radius: 8px; padding: 1rem 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); flex-wrap: wrap; }
    .meta-item .k { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6c757d; }
    .meta-item .v { font-weight: 600; margin-top: 0.1rem; }
    .turn { display: flex; gap: 1rem; margin-bottom: 1rem; }
    .turn-label { width: 80px; flex-shrink: 0; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; padding-top: 0.9rem; color: #6c757d; text-align: right; }
    .turn-label.user { color: #0d6efd; }
    .turn-label.assistant { color: #198754; }
    .turn-bubble { background: white; border-radius: 8px; padding: 0.85rem 1rem; flex: 1; box-shadow: 0 1px 3px rgba(0,0,0,.08); font-size: 0.9rem; line-height: 1.5; white-space: pre-wrap; }
    .verdict { background: white; border-radius: 8px; padding: 1.25rem 1.5rem; margin-top: 2rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .verdict h2 { margin: 0 0 1rem; font-size: 1rem; }
    .outcome-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.4rem 0; border-top: 1px solid #f1f3f5; font-size: 0.9rem; }
    .outcome-row:first-child { border-top: none; }
    .pill { display: inline-block; padding: 0.15em 0.5em; border-radius: 99px; font-size: 0.7rem; font-weight: 700; }
    .pill-pass { background: #d1e7dd; color: #0a3622; }
    .pill-fail { background: #f8d7da; color: #58151c; }
    .back { font-size: 0.85rem; }
    footer { text-align: center; color: #6c757d; font-size: 0.8rem; padding: 2rem; margin-top: 3rem; }
  </style>
</head>
<body>
<header>
  <h1>{{.Label}}</h1>
  <p><a href="../index.html" style="color:rgba(255,255,255,0.7)">← All Cases</a></p>
</header>
<main>

  <div class="meta">
    <div class="meta-item"><div class="k">Persona</div><div class="v">{{.PersonaID}}</div></div>
    <div class="meta-item"><div class="k">Scenario</div><div class="v">{{.ScenarioID}}</div></div>
    <div class="meta-item"><div class="k">Info Level</div><div class="v">{{.InfoLevel}}</div></div>
    <div class="meta-item"><div class="k">Rep</div><div class="v">{{.Rep}}</div></div>
    <div class="meta-item"><div class="k">End Reason</div><div class="v">{{.EndReason}}</div></div>
    <div class="meta-item"><div class="k">Turns</div><div class="v">{{len .Transcript.Turns}}</div></div>
    {{if .Verdict}}<div class="meta-item"><div class="k">Composite</div><div class="v">{{printf "%.3f" .Verdict.Composite}}</div></div>{{end}}
  </div>

  <h2 style="font-size:1rem;margin:1.5rem 0 0.75rem">Conversation</h2>
  {{range .Transcript.Turns}}
  <div class="turn">
    <div class="turn-label {{.Role}}">{{if eq .Role "user"}}User{{else}}Advisor{{end}}</div>
    <div class="turn-bubble">{{.Text}}</div>
  </div>
  {{end}}

  {{if .Verdict}}
  <div class="verdict">
    <h2>Verdict</h2>
    {{range $id, $pass := .Verdict.HardGates}}
    <div class="outcome-row">
      <span class="pill {{if $pass}}pill-pass{{else}}pill-fail{{end}}">{{if $pass}}PASS{{else}}FAIL{{end}}</span>
      <strong>{{$id}}</strong> <span style="color:#6c757d;font-size:0.8rem">(hard gate)</span>
    </div>
    {{end}}
    {{range $id, $r := .Verdict.Outcomes}}
    <div class="outcome-row">
      <span class="pill {{if $r.Pass}}pill-pass{{else}}pill-fail{{end}}">{{if $r.Pass}}PASS{{else}}FAIL{{end}}</span>
      <strong>{{$id}}</strong>
      {{if $r.Notes}}<span style="color:#6c757d;font-size:0.85rem">— {{$r.Notes}}</span>{{end}}
    </div>
    {{end}}
    {{if .Verdict.Notes}}
    <p style="margin-top:1rem;font-size:0.9rem;color:#495057">{{.Verdict.Notes}}</p>
    {{end}}
  </div>
  {{end}}

</main>
<footer>Generated by <strong>Lens</strong></footer>
</body>
</html>
