<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lens — {{.ExperimentName}} Results</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; background: #f8f9fa; color: #212529; }
    header { background: #1a1a2e; color: white; padding: 1.5rem 2rem; }
    header h1 { margin: 0; font-size: 1.5rem; }
    header p { margin: 0.25rem 0 0; opacity: 0.7; font-size: 0.9rem; }
    main { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; }
    .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: white; border-radius: 8px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .stat-card .label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6c757d; }
    .stat-card .value { font-size: 2rem; font-weight: 700; margin-top: 0.25rem; }
    .stat-card .value.good { color: #198754; }
    .stat-card .value.bad { color: #dc3545; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.08); overflow: hidden; }
    th { background: #f1f3f5; padding: 0.75rem 1rem; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6c757d; }
    td { padding: 0.75rem 1rem; border-top: 1px solid #f1f3f5; font-size: 0.9rem; }
    tr:hover td { background: #f8f9fa; }
    .badge { display: inline-block; padding: 0.2em 0.6em; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
    .badge-done { background: #d1e7dd; color: #0a3622; }
    .badge-dropout { background: #fff3cd; color: #664d03; }
    .badge-maxturns { background: #cfe2ff; color: #084298; }
    .badge-error { background: #f8d7da; color: #58151c; }
    .composite-bar { display: flex; align-items: center; gap: 0.5rem; }
    .bar-bg { flex: 1; background: #e9ecef; border-radius: 99px; height: 6px; }
    .bar-fill { height: 6px; border-radius: 99px; background: #0d6efd; }
    a { color: #0d6efd; text-decoration: none; }
    a:hover { text-decoration: underline; }
    h2 { margin: 2rem 0 1rem; font-size: 1.1rem; }
    footer { text-align: center; color: #6c757d; font-size: 0.8rem; padding: 2rem; margin-top: 3rem; }
  </style>
</head>
<body>
<header>
  <h1>📊 {{.ExperimentName}}</h1>
  <p>{{.GeneratedAt}} · {{.TotalCases}} cases · {{.Workers}} workers</p>
</header>
<main>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="label">Composite Score</div>
      <div class="value {{if ge .MeanComposite 0.7}}good{{else if lt .MeanComposite 0.4}}bad{{end}}">
        {{printf "%.2f" .MeanComposite}}
      </div>
    </div>
    <div class="stat-card">
      <div class="label">Total Cases</div>
      <div class="value">{{.TotalCases}}</div>
    </div>
    <div class="stat-card">
      <div class="label">Completed (DONE)</div>
      <div class="value {{if ge .DonePct 80.0}}good{{end}}">{{printf "%.0f" .DonePct}}%</div>
    </div>
    <div class="stat-card">
      <div class="label">Errors</div>
      <div class="value {{if gt .Errors 0}}bad{{end}}">{{.Errors}}</div>
    </div>
  </div>

  <h2>Cases</h2>
  <table>
    <thead>
      <tr>
        <th>Label</th>
        <th>Persona</th>
        <th>Scenario</th>
        <th>Info Level</th>
        <th>Rep</th>
        <th>End Reason</th>
        <th>Turns</th>
        <th>Composite</th>
      </tr>
    </thead>
    <tbody>
      {{range .Cases}}
      <tr>
        <td><a href="cases/{{.Label}}.html">{{.Label}}</a></td>
        <td>{{.PersonaID}}</td>
        <td>{{.ScenarioID}}</td>
        <td>{{.InfoLevel}}</td>
        <td>{{.Rep}}</td>
        <td><span class="badge badge-{{endReasonClass .EndReason}}">{{.EndReason}}</span></td>
        <td>{{.Turns}}</td>
        <td>
          {{if .Verdict}}
          <div class="composite-bar">
            <div class="bar-bg"><div class="bar-fill" style="width:{{compositeWidth .Verdict.Composite}}%"></div></div>
            <span>{{printf "%.2f" .Verdict.Composite}}</span>
          </div>
          {{else}}—{{end}}
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>

</main>
<footer>Generated by <strong>Lens</strong> · github.com/mgm702/lens</footer>
</body>
</html>
